# Template for Kubernetes Secret
# Copy this file to secret.yaml and replace values with base64-encoded secrets
#
# To encode a value: echo -n "your-value" | base64
# DO NOT commit secret.yaml to Git!

apiVersion: v1
kind: Secret
metadata:
  name: ultrasharp-secrets
  labels:
    app: ultrasharp-tools-server
type: Opaque
data:
  # Example: GitHub Personal Access Token for private repositories
  # github-token: <base64-encoded-token>

  # Example: NuGet API Key for private feeds
  # nuget-api-key: <base64-encoded-key>

  # Add your secrets here as needed
