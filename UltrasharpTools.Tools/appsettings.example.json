{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "SharpTools": "Information"
    }
  },

  "Embedding": {
    // Provider: "auto" (auto-detect), "tei", "ollama", "memory"
    "Provider": "auto",

    // Enable embeddings
    "Enabled": true,

    // Auto-detect GPU and select optimal provider
    "AutoDetectGPU": true,

    // TEI (Text Embeddings Inference) - 8192 tokens context
    // Requires RTX 30xx+ (Compute Capability 8.0+) and Docker
    "TEI": {
      "BaseUrl": "http://127.0.0.1:8080",
      "Model": "ibm-granite/granite-embedding-english-r2",
      "TimeoutMs": 30000,
      "Concurrency": 4,
      "CheckServer": true,
      "AutoStart": true,
      "ContainerName": "tei-server"
    },

    // Ollama - 512 tokens context
    // Simple installation, no Docker required
    "Ollama": {
      "BaseUrl": "http://127.0.0.1:11434",
      "Model": "granite-embedding",
      "TimeoutMs": 10000,
      "Concurrency": 4,
      "AutoPull": true,
      "CheckServer": true
    },

    // Memory Provider - No ML embeddings (fallback)
    "Memory": {
      "UseDeterministicHash": true
    }
  }
}
