<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>Exe</OutputType>
<TargetFramework>net10.0</TargetFramework>
<LangVersion>13.0</LangVersion>
<ImplicitUsings>enable</ImplicitUsings>
<Nullable>enable</Nullable>
<Version>3.0.6</Version>
<AssemblyName>UltraSharpTools.Comm</AssemblyName>
<RootNamespace>UltraSharpTools.Comm</RootNamespace>

<!-- Отключение глобализации: только en-US, экономия ~2 MB -->
<InvariantGlobalization>true</InvariantGlobalization>
<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
</PropertyGroup>

<!-- Self-contained for Debug (without trimming for faster builds) -->
<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
<SelfContained>true</SelfContained>
<RuntimeIdentifier>win-x64</RuntimeIdentifier>
<PublishSingleFile>true</PublishSingleFile>
</PropertyGroup>

<!-- Self-contained with trimming for Release (minimal size) -->
<PropertyGroup Condition="'$(Configuration)' == 'Release'">
<!-- Self-contained: includes .NET runtime (needed since Comm starts independently) -->
<SelfContained>true</SelfContained>
<RuntimeIdentifier>win-x64</RuntimeIdentifier>
<PublishSingleFile>true</PublishSingleFile>

<!-- Trimming: remove unused code -->
<PublishTrimmed>true</PublishTrimmed>
<TrimMode>full</TrimMode>
<EnableTrimAnalyzer>true</EnableTrimAnalyzer>

<!-- Size optimizations -->
<DebugType>none</DebugType>
<DebugSymbols>false</DebugSymbols>
<Optimize>true</Optimize>
</PropertyGroup>

<!-- System.IO.Pipelines и System.Text.Json включены в .NET 10 -->
</Project>
