<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>Exe</OutputType>
<TargetFramework>net10.0</TargetFramework>
<LangVersion>13.0</LangVersion>
<ImplicitUsings>enable</ImplicitUsings>
<Nullable>enable</Nullable>
<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
<Version>3.2.1</Version>
<AssemblyName>UltraSharpTools.Comm</AssemblyName>
<RootNamespace>UltraSharpTools.Comm</RootNamespace>

<!-- Отключение глобализации: только en-US, экономия ~2 MB -->
<InvariantGlobalization>true</InvariantGlobalization>
<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
</PropertyGroup>

<!-- Self-contained for Debug (without trimming for faster builds) -->
<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
</PropertyGroup>

<!-- Optimization settings for Release builds -->
<!-- PublishAot, RuntimeIdentifier, and SelfContained are specified via command line in build scripts -->
<PropertyGroup Condition="'$(Configuration)' == 'Release'">
<OptimizationPreference>Speed</OptimizationPreference>
<IlcOptimizationPreference>Speed</IlcOptimizationPreference>

<PublishTrimmed>true</PublishTrimmed>
<TrimMode>full</TrimMode>
<EnableTrimAnalyzer>true</EnableTrimAnalyzer>

<StripSymbols>true</StripSymbols>
</PropertyGroup>

<!-- System.IO.Pipelines и System.Text.Json включены в .NET 10 -->
</Project>
