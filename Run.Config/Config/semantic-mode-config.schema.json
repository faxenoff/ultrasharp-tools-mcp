{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/your-org/ultrasharp-tools-mcp/semantic-mode-config.schema.json",
  "title": "Universal Semantic Mode Configuration",
  "description": "Configuration for Universal Semantic Mode (Phase 12) - semantic enrichment for all 52 tools",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable Universal Semantic Mode",
      "default": true
    },
    "availability": {
      "type": "object",
      "description": "Availability check settings",
      "properties": {
        "cacheValiditySeconds": {
          "type": "integer",
          "description": "Cache validity period in seconds",
          "minimum": 1,
          "default": 300
        },
        "localCheckTimeoutSeconds": {
          "type": "integer",
          "description": "Timeout for local embedding check in seconds",
          "minimum": 1,
          "default": 3
        },
        "overlordCheckTimeoutSeconds": {
          "type": "integer",
          "description": "Timeout for Overlord check in seconds",
          "minimum": 1,
          "default": 5
        },
        "embeddingSourcePreference": {
          "type": "string",
          "description": "Preferred source for embedding operations",
          "enum": ["local", "overlord", "auto"],
          "default": "auto"
        },
        "searchSourcePreference": {
          "type": "string",
          "description": "Preferred source for search operations",
          "enum": ["local", "overlord", "auto"],
          "default": "auto"
        }
      },
      "required": ["cacheValiditySeconds", "localCheckTimeoutSeconds", "overlordCheckTimeoutSeconds", "embeddingSourcePreference", "searchSourcePreference"],
      "additionalProperties": false
    },
    "enrichment": {
      "type": "object",
      "description": "Enrichment operation settings",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "description": "Timeout for enrichment operations in seconds",
          "minimum": 1,
          "default": 5
        },
        "maxConcurrency": {
          "type": "integer",
          "description": "Maximum concurrent enrichment operations",
          "minimum": 1,
          "default": 5
        },
        "gracefulDegradation": {
          "type": "boolean",
          "description": "Enable graceful degradation on errors",
          "default": true
        },
        "logSuccessfulEnrichments": {
          "type": "boolean",
          "description": "Log successful enrichment operations",
          "default": false
        },
        "logFailedEnrichments": {
          "type": "boolean",
          "description": "Log failed enrichment operations",
          "default": true
        },
        "minMatchesForEnrichment": {
          "type": "integer",
          "description": "Minimum number of matches required for enrichment",
          "minimum": 0,
          "default": 1
        }
      },
      "required": ["timeoutSeconds", "maxConcurrency", "gracefulDegradation", "logSuccessfulEnrichments", "logFailedEnrichments", "minMatchesForEnrichment"],
      "additionalProperties": false
    },
    "toolSettings": {
      "type": "object",
      "description": "Per-tool enrichment settings",
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable enrichment for this tool",
              "default": true
            },
            "topK": {
              "type": "integer",
              "description": "Number of top results to return from semantic search",
              "minimum": 1,
              "default": 5
            },
            "threshold": {
              "type": "number",
              "description": "Similarity threshold (0.0 to 1.0)",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.7
            },
            "queryTemplate": {
              "type": "string",
              "description": "Custom query template for this tool. Placeholders: {toolName}, {arguments}, {result}"
            }
          },
          "required": ["enabled", "topK", "threshold"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["enabled", "availability", "enrichment", "toolSettings"],
  "additionalProperties": false,
  "examples": [
    {
      "enabled": true,
      "availability": {
        "cacheValiditySeconds": 300,
        "localCheckTimeoutSeconds": 3,
        "overlordCheckTimeoutSeconds": 5,
        "embeddingSourcePreference": "auto",
        "searchSourcePreference": "auto"
      },
      "enrichment": {
        "timeoutSeconds": 5,
        "maxConcurrency": 5,
        "gracefulDegradation": true,
        "logSuccessfulEnrichments": false,
        "logFailedEnrichments": true,
        "minMatchesForEnrichment": 1
      },
      "toolSettings": {
        "view_definition": {
          "enabled": true,
          "topK": 5,
          "threshold": 0.7
        },
        "find_references": {
          "enabled": true,
          "topK": 10,
          "threshold": 0.65
        },
        "modify_code": {
          "enabled": true,
          "topK": 8,
          "threshold": 0.7
        }
      }
    }
  ]
}
