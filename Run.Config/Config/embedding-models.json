{
  "version": "1.0.0",
  "providers": {
    "tei": {
      "name": "TEI (Text Embeddings Inference)",
      "description": "HuggingFace официальный inference сервер\n✅ Высокий контекст (до 8192 токенов)\n🚀 Авто-определение GPU (RTX 30xx/40xx/50xx)\n🐳 Требуется Docker Desktop\n⚡ В 5-10 раз быстрее на GPU",
      "requires": ["docker"],
      "optional": ["nvidia-gpu"],
      "default_port": 8080,
      "container_name": "tei-server"
    },
    "ollama": {
      "name": "Ollama",
      "description": "Простая локальная установка без Docker\n✅ Легкая установка\n🎮 Авто-определение GPU\n⚠️  Контекст зависит от модели (512-8192 токенов)\n📦 Меньший размер загрузки",
      "requires": ["ollama"],
      "optional": ["nvidia-gpu"],
      "default_port": 11434
    },
    "memory": {
      "name": "Memory Provider (без ML)",
      "description": "Hash-based embeddings (без ML)\n⚠️  Только детерминированный хеш\n✅ Установка не требуется\n⚡ Мгновенно, без вычислений",
      "requires": [],
      "optional": []
    }
  },
