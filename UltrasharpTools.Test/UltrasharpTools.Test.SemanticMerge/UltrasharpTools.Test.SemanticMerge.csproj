<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <StartupObject>UltrasharpTools.Test.SemanticMerge.UmbracoMergeTest</StartupObject>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Отключение глобализации: только en-US, экономия ~5 MB + ускорение старта -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Отключение сателитных сборок локализации (для NuGet пакетов типа Roslyn) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltrasharpTools.Test.Common\UltrasharpTools.Test.Common.csproj" />
  </ItemGroup>
</Project>
