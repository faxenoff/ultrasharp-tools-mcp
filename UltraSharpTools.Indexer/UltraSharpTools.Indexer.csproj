<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>Exe</OutputType>
<TargetFramework>net10.0</TargetFramework>
<LangVersion>13.0</LangVersion>
<ImplicitUsings>enable</ImplicitUsings>
<Nullable>enable</Nullable>
<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
<Version>3.0.7</Version>
<AssemblyName>UltraSharpTools.Indexer</AssemblyName>
<RootNamespace>UltraSharpTools.Indexer</RootNamespace>

<!-- Копирование всех зависимостей -->
<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

<!-- Оптимизации -->
<TieredCompilation>true</TieredCompilation>
<TieredPGO>true</TieredPGO>
<DynamicPGO>true</DynamicPGO>

<!-- Отключение глобализации -->
<InvariantGlobalization>true</InvariantGlobalization>
<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
</PropertyGroup>

<!-- Native AOT для Release сборки -->
<PropertyGroup Condition="'$(Configuration)' == 'Release'">
<PublishAot>true</PublishAot>
<OptimizationPreference>Speed</OptimizationPreference>
<IlcOptimizationPreference>Speed</IlcOptimizationPreference>

<PublishTrimmed>true</PublishTrimmed>
<TrimMode>full</TrimMode>
<EnableTrimAnalyzer>true</EnableTrimAnalyzer>

<SelfContained>true</SelfContained>
<RuntimeIdentifier>win-x64</RuntimeIdentifier>

<StripSymbols>true</StripSymbols>
</PropertyGroup>

<ItemGroup>
<!-- Semantic indexing dependencies -->
<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
<PackageReference Include="System.IO.Hashing" Version="10.0.0" />
</ItemGroup>

<!-- Vectorlite native library -->
<ItemGroup>
<None
Include="Native\vectorlite.dll"
CopyToOutputDirectory="PreserveNewest"
Link="vectorlite.dll"
/>
</ItemGroup>
</Project>
