<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\UltrasharpTools.Tools\UltrasharpTools.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.8.0-preview.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>3.7.2</Version>
    <AssemblyName>UltrasharpTools.Overlord</AssemblyName>
    <RootNamespace>UltrasharpTools.Overlord</RootNamespace>

    <!-- Копирование всех зависимостей NuGet (включая транзитивные от UltrasharpTools.Tools) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Отключение глобализации: только en-US, экономия ~5 MB + ускорение старта -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Отключение сателитных сборок локализации (для NuGet пакетов типа Roslyn) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Performance Optimizations (Release only) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Framework-dependent: shared runtime в ../shared/ -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Tiered Compilation для оптимизации hot paths -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>

    <!-- Dynamic Profile-Guided Optimization (.NET 8+, 30-50% perf improvement) -->
    <TieredPGO>true</TieredPGO>
    <!-- Dynamic PGO: Continuous optimization based on runtime behavior -->
    <DynamicPGO>true</DynamicPGO>

    <!-- Server GC для лучшей throughput (важно для обработки больших решений) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>

    <!-- Code quality optimizations -->
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
