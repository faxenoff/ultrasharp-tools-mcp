<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\UltrasharpTools.Tools\UltrasharpTools.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>

    <!-- Копирование всех зависимостей NuGet (включая транзитивные от UltrasharpTools.Tools) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Performance Optimizations (Release only) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- ReadyToRun AOT для ускорения старта (20-50% faster startup) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <PublishReadyToRunEmitSymbols>false</PublishReadyToRunEmitSymbols>
    <PublishReadyToRunUseCrossgen2>true</PublishReadyToRunUseCrossgen2>

    <!-- Tiered Compilation: R2R Tier 0 → Optimized JIT Tier 1 (для hot paths) -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>

    <!-- Dynamic Profile-Guided Optimization (.NET 8+, 30-50% perf improvement) -->
    <TieredPGO>true</TieredPGO>
    <!-- Dynamic PGO: Continuous optimization based on runtime behavior -->
    <DynamicPGO>true</DynamicPGO>

    <!-- Server GC для лучшей throughput (важно для обработки больших решений) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>

    <!-- Code quality optimizations -->
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Clean up PDB files after publish (Release only) -->
  <!-- Note: BuildHost directories cleaned by publish-mcp.ps1 -->
  <Target Name="CleanPublishOutput" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <!-- Remove all PDB files (embedded debug info is in DLLs) -->
      <PdbFiles Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>

    <Delete Files="@(PdbFiles)" />

    <Message Importance="high" Text="Cleaned up PDB files from publish output" Condition="'@(PdbFiles)' != ''" />
  </Target>

</Project>
